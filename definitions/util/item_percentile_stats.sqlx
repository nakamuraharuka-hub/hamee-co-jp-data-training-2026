config {
  type: "view",
  schema: "kdec_util"
}

with sales as (
  select
   s.product_id,
   s.order_year_month,
   sum(i.sale_price) as month_sales
  from ${ref("kdec_util", "item_order_stats")} s
  left join ${ref("kdec_adapter", "order_items")} i
    on s.order_id = i.order_id
    and s.product_id = i.product_id
  group by s.product_id, s.order_year_month
),

total as (
  select
   product_id,
   sum(month_sales) as total_sales,
   ntile(10) over(order by sum(month_sales) desc) * 10 as total_rank
  from sales
  group by product_id
),

month as (
  select
   product_id,
   order_year_month,
   month_sales,
   ntile(10) over(partition by order_year_month order by month_sales desc) * 10 as month_rank
  from sales
)

SELECT
 m.product_id,
 m.order_year_month,
 t.total_rank as item_percentile_total_rank,
 min(t.total_sales) over(partition by t.total_rank) as item_percentile_total_base,
 m.month_rank as item_percentile_month_rank,
 min(m.month_sales) over(partition by m.order_year_month, m.month_rank) as item_percentile_month_base
FROM month m
left join total t
  on m.product_id = t.product_id